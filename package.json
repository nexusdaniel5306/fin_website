{
  "name": "fin-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:fixtures": "SENTIMENT_HISTORY_FIXTURES=1 next dev",
    "build": "next build",
    "build:fixtures": "SENTIMENT_HISTORY_FIXTURES=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.tests.json && node --test .tmp-tests/tests/*.test.js",
    "test:groq": "tsc -p tsconfig.tests.json && GROQ_LIVE_TEST=1 node --test --test-name-pattern='GPT-OSS structured output' .tmp-tests/tests/groq-live.test.js"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@upstash/qstash": "^2.11.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^0.427.0",
    "next": "^16.3.4",
    "react": "^18",
    "react-dom": "^18",
    "redis": "^5.11.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
